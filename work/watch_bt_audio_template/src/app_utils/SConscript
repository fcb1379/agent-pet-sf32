Import('RTT_ROOT')
Import('rtconfig')
from building import *
import os

cwd = GetCurrentDir()
src = ['main.c', 'noise_monitor.c', 'agent_pet_merit.c', 'pet_behavior.c']

if GetDepend('BSP_USING_PC_SIMULATOR'):
    # The full UI target needs stable service state but has no BLE, flash,
    # audio codec, or interrupt controller. Keep all PC behavior in one mock.
    src += ['pc_simulator_services.c']
else:
    src += ['audio_diagnostics.c']

    if GetDepend('AGENT_PET_USING_IMU'):
        src += ['pet_imu.c']

    if GetDepend('BSP_BLE_SIBLES') and os.path.exists(os.path.join(cwd, 'ble_app.c')):
        src += ['ble_app.c']

    if GetDepend('BSP_BT_APP') and os.path.exists(os.path.join(cwd, 'bt_app.c')):
        src += ['bt_app.c']

    if GetDepend('BSP_SHARE_PREFS'):
        src += ['watch_settings.c', 'watch_alarm_service.c']

    if GetDepend('CFG_AV_SNK'):
        src += ['bt_audio_sink.c']

    if GetDepend('AUDIO_LOCAL_MUSIC'):
        src += ['local_music_player.c']

    if GetDepend('BSP_BLE_SIBLES'):
        src += ['ble_watch_link.c', 'watch_protocol.c',
                'agent_pet_protocol.c', 'agent_pet_image_transfer.c',
                'agent_pet_ble_service.c', 'agent_pet_md5_backend.c']

    if GetDepend('BSP_BLE_WATCH_FACE'):
        src += ['badge_transfer.c']

    if GetDepend('BSP_USING_DATA_SVC'):
        src += ['ble_ios_services.c']


CPPPATH = [cwd, os.path.normpath(os.path.join(RTT_ROOT, '..', '..', 'external', 'mbedtls', 'include'))]
LINKFLAGS = []

if GetDepend('PKG_USING_CMBACKTRACE'):
    # CmBacktrace uses conventional GNU stack symbols while the SF32LB52
    # linker script exports CMSIS names. Provide aliases without patching SDK.
    LINKFLAGS += ['-Wl,--defsym=_sstack=__StackLimit',
                  '-Wl,--defsym=_estack=__StackTop']
    group = DefineGroup('App_utils', src, depend = [''], CPPPATH = CPPPATH,
                        LINKFLAGS = LINKFLAGS)
else:
    # Passing an empty LINKFLAGS list through the legacy PC SCons backend
    # creates an empty object-file argument and breaks the final MSVC link.
    group = DefineGroup('App_utils', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
