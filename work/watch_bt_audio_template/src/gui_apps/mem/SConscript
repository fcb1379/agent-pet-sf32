from building import *
import rtconfig

# get current dir path
cwd = GetCurrentDir()

# init src and inc vars
src = []
inc = [cwd]

# The hardware SDK already supplies app_mem.c. Keep the local implementation
# only for the PC simulator, where the SDK object is not available.
if GetDepend('BSP_USING_PC_SIMULATOR'):
    src = src + Glob('*.c')

LOCAL_CCFLAGS = ''

group = DefineGroup('App_watch_component', src, depend = [''], CPPPATH = inc, LOCAL_CCFLAGS = LOCAL_CCFLAGS)

Return('group')
