import os
import rtconfig

# Check SDK 
SIFLI_SDK = os.getenv('SIFLI_SDK')
if not SIFLI_SDK:
    print("Please run set_env.bat in root folder of SIFLI SDK to set environment.")
    exit()
from building import *

# Prepare environment.
PrepareEnv()

################################## change rtconfig.xxx to customize build ########################################

# Add bootloader project
AddBootLoader(SIFLI_SDK,rtconfig.CHIP)

# Add LCPU project for Bluetooth/BLE controller firmware.
AddLCPU(SIFLI_SDK,rtconfig.CHIP,"../src/lcpu_img.c")

# Set default compile options
SifliEnv()

# SiFli-SDK v2.4 declares a few public APIs with uint8_t before including
# stdint.h. The legacy VS2017 headers accepted that include order, while
# current MSVC does not. Keep the compatibility include scoped to the PC
# simulator so embedded builds are unchanged.
if rtconfig.PLATFORM == 'cl':
    rtconfig.CFLAGS += (' /FIstdint.h'
                        ' /DLCD_HOR_RES_MAX=390'
                        ' /DLCD_VER_RES_MAX=490')

TARGET = rtconfig.OUTPUT_DIR + rtconfig.TARGET_NAME + '.' + rtconfig.TARGET_EXT
# Prepare building environment
objs = PrepareBuilding(None)
env = GetCurrentEnv()

# Build application.
DoBuilding(TARGET, objs)

# Add flash table buld.
AddFTAB(SIFLI_SDK,rtconfig.CHIP)

# Add file system image for local media assets.
fs_bin=FileSystemBuild("../disk", env)
AddCustomImg("fs_root",bin=[fs_bin])

# Generate download .bat script
GenDownloadScript(env)
